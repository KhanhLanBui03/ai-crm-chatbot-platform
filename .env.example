# Chép thành .env rồi chỉnh. File .env KHÔNG được commit (xem .gitignore).
#   cp .env.example .env

# ─── Cổng trên MÁY CHỦ ───────────────────────────────────────────────
# Đổi khi máy bạn đã có dịch vụ khác giữ cổng đó. Cổng BÊN TRONG mạng Docker
# không đổi, nên các service vẫn gọi nhau bằng postgres:5432, kafka:9092.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=29092
ZOOKEEPER_HOST_PORT=2181
# 9000 đã dành cho mcp-server-mock, nên kho tệp S3 ra 9010 (API) và 9011 (giao diện web).
S3_HOST_PORT=9010
S3_CONSOLE_HOST_PORT=9011

# ─── PostgreSQL ──────────────────────────────────────────────────────
DB_NAME=thesis_crm

# Chủ bảng — CHỈ dùng cho Flyway. Có quyền DDL và bypass RLS.
DB_MIGRATION_USER=crm_owner
DB_MIGRATION_PASSWORD=changeme

# Tài khoản lúc chạy — KHÔNG phải chủ bảng, chịu RLS (ADR-0001).
# Dùng nhầm chủ bảng ở runtime là vô hiệu hóa toàn bộ cô lập tenant.
DB_USERNAME=crm_app
DB_PASSWORD=changeme
AI_DB_USERNAME=ai_app
AI_DB_PASSWORD=changeme

# ─── Kho tệp S3 — RustFS ở dev, AWS S3 trên cloud (ADR-0022) ─────────
# Tài khoản gốc của RustFS, CHỈ cho dev. Cloud để trống hai khoá: ai-service tự lấy
# quyền qua IAM role (IRSA). Giao diện web: http://localhost:9011 (đăng nhập bằng cặp khoá này).
S3_REGION=us-east-1
S3_BUCKET=kb-tai-lieu
S3_ACCESS_KEY=kb-dev
S3_SECRET_KEY=changeme-dev

# ─── Web Widget (UC009/UC010) ────────────────────────────────────────
# Khoá ký token phiên của khách vãng lai — KHÁC khoá JWT nhân viên. ≥ 32 ký tự, mỗi môi trường một khoá.
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Để COMMENT khi chưa có khoá, đừng để "WIDGET_TOKEN_SECRET=" trống: profile `local` của java-core nạp
# thẳng file .env, Spring coi chuỗi rỗng là đã có giá trị ⇒ khoá 0 byte ⇒ java-core không khởi động.
# Comment thì cả Docker (${…:-mặc định}) lẫn chạy trên máy đều rơi về khoá dev.
# WIDGET_TOKEN_SECRET=
# Hai địa chỉ ghi vào mã nhúng — địa chỉ mà TRÌNH DUYỆT CỦA KHÁCH truy cập được
WIDGET_SCRIPT_URL=http://localhost:5174/widget.js
WIDGET_PUBLIC_API_URL=http://localhost:8080
# Khoá công khai cho trang "Cửa hàng Demo" (localhost:3000) VÀ mục "Trải nghiệm Chat" trên trang chủ
# dashboard — lấy ở dashboard sau khi "Sinh mã nhúng"; khai "localhost" trong "Tên miền cho phép"
DEMO_WIDGET_KEY=

# ─── MCP ─────────────────────────────────────────────────────────────
# mcp-server-mock chạy ở REPOSITORY RIÊNG (../mcp-server-mock), ngoài compose này.
MCP_SERVER_URL=http://host.docker.internal:9000

# ─── Mô hình ngôn ngữ ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Grafana (profile observability) ─────────────────────────────────
GRAFANA_PASSWORD=admin
