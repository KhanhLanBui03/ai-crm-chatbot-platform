# --- Máy chủ ---
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# --- CSDL: schema knowledge, ai, integration (Track B sở hữu) ---
# LƯU Ý: ai-service KHÔNG đọc/ghi schema nghiệp vụ của Track A (ADR-0002).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=thesis_crm
DB_USERNAME=ai_app
DB_PASSWORD=changeme

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_CONSUMER_GROUP=ingestion-cg

# --- Eureka (đăng ký thủ công bằng py-eureka-client) ---
EUREKA_URL=http://eureka-server:8761/eureka
EUREKA_APP_NAME=ai-service

# --- java-core: bề mặt DUY NHẤT để chạm dữ liệu nghiệp vụ ---
JAVA_CORE_URL=http://java-core:8081

# --- MCP: repository riêng mcp-server-mock ---
MCP_SERVER_URL=http://host.docker.internal:9000
MCP_SPEC_VERSION=2025-06-18

# --- Nhà cung cấp mô hình — client trung lập chuẩn OpenAI chat completions (ADR-0028) ---
# mock: câu trả lời cố định, không mạng (mặc định — CI và lúc phát triển không đốt hạn mức).
# remote: gọi LLM_BASE_URL. Bật khi đo thật: LLM_MODE=remote python -m src.entrypoint
LLM_MODE=mock
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Khoá Google AI Studio — KHÔNG commit. Trống mà LLM_MODE=remote thì ai-service không khởi động.
LLM_API_KEY=
# Chọn bằng phép thử 10 câu (docs/report/uc023-thu-llm-2026-10-08.md). Đổi model thì chạy lại
# python -m tests.eval.thu_llm --model <tên> trước: mỗi model nhận một tập reasoning_effort khác.
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=minimal
# Bắt buộc để tái lập thí nghiệm (mục 8.1)
LLM_TEMPERATURE=0
# ANTHROPIC_* không còn được đọc từ 08/10 (ADR-0028) — giữ để .env cũ không vỡ
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
REFUSAL_THRESHOLD=0.5

# --- Kho tệp S3 (ADR-0022) — RustFS ở dev ---
# Chạy trên máy: localhost:9010. Trong compose, docker-compose.yml tự đặt rustfs:9000.
S3_ENDPOINT=localhost:9010
S3_ACCESS_KEY=kb-dev
S3_SECRET_KEY=changeme-dev

# --- Tầng suy luận (§3.4.1) ---
# mock: vector + phân loại ý định giả, seed cố định — chạy được khi chưa bật inference/.
# remote: gọi ai-embed / ai-classify thật (cần EMBED_URL, INFERENCE_CLASSIFY_URL).
AI_MODE=mock
# Chạy ai-service trên máy, tầng suy luận bằng inference/compose.inference.yml — bỏ comment hai dòng
# dưới. Trong mạng Docker thì để mặc định (http://ai-embed:8080, http://ai-classify:8080).
# EMBED_URL=http://localhost:8091
# INFERENCE_CLASSIFY_URL=http://localhost:8083
