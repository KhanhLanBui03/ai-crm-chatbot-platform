# --- Máy chủ ---
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# --- CSDL: schema knowledge, ai, integration (Track B sở hữu) ---
# LƯU Ý: ai-service KHÔNG đọc/ghi schema nghiệp vụ của Track A (ADR-0002).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=thesis_crm
DB_USERNAME=ai_app
DB_PASSWORD=changeme

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_CONSUMER_GROUP=ingestion-cg

# --- Eureka (đăng ký thủ công bằng py-eureka-client) ---
EUREKA_URL=http://eureka-server:8761/eureka
EUREKA_APP_NAME=ai-service

# --- java-core: bề mặt DUY NHẤT để chạm dữ liệu nghiệp vụ ---
JAVA_CORE_URL=http://java-core:8081

# --- MCP: repository riêng mcp-server-mock ---
MCP_SERVER_URL=http://host.docker.internal:9000
MCP_SPEC_VERSION=2025-06-18

# --- Nhà cung cấp mô hình ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Mô hình rẻ cho nhánh định tuyến — thí nghiệm E10
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001
# Bắt buộc để tái lập thí nghiệm (mục 8.1)
LLM_TEMPERATURE=0

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
REFUSAL_THRESHOLD=0.5
